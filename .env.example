# Firebase web app config (Firebase Console → Project settings → Your apps → Web app).
# Copy to .env and fill in. These identify the project; security comes from
# Firestore rules. Never commit .env.
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Local admin scripts only (scripts/promote-user.mjs). Not read by the app.
# Path to a service-account key; the file must stay git-ignored.
FIREBASE_ADMIN_SERVICE_ACCOUNT=./firebase/service-account.json
